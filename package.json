{
    "name": "@dpuse/dpuse-tool-streamparser-json-parser",
    "version": "1.0.3",
    "private": false,
    "description": "Reads JSON and JSON Lines as a stream, and maps their structure for browsing and choosing tables.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "sideEffects": false,
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-tool-streamparser-json-parser/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-tool-streamparser-json-parser.git"
    },
    "module": "./dist/dpuse-tool-streamparser-json-parser.es.js",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "import": "./dist/dpuse-tool-streamparser-json-parser.es.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "fsevents@2.3.3": true,
        "esbuild@0.28.2": true,
        "workerd@1.20261110.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "node -e \"import('@dpuse/dpuse-development').then(m => m.buildProject())\"",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('MIT'))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && node -e \"import('@dpuse/dpuse-development').then(m => m.triggerGitHubRelease())\"",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\""
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^1.0.214",
        "@streamparser/json": "^0.0.26"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.149",
        "@dpuse/eslint-config-dpuse": "^1.0.150",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "prettier": "^3.10.1",
        "sonda": "^0.14.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.1.0",
        "wrangler": "^4.161.0"
    }
}
